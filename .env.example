# ==============================================================================
# PR Triage Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual configuration values.
# DO NOT commit your actual '.env' file containing real secrets to git.
# ==============================================================================

# GitHub Personal Access Token (PAT) with repository read/triage scope
# Required: YES
# Example: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target GitHub Repository (Format: owner/repository-name)
# Optional: Can also be specified via the CLI --repo argument
GITHUB_REPO=your-org-or-username/your-repository-name

# OpenAI API Key (Required only if AI features / PR slop detection are enabled)
# Optional: Set if using OpenAI analysis features
# Example: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Logging & Debug Mode (Set to true for verbose JSON logs)
# Optional: default is false
DEBUG=false
